---
import type { CollectionEntry } from "astro:content";
import { isoDate } from "@/lib/site";

interface Props {
	post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, date, description, subtitle, tags } = post.data;
const summary = description ?? subtitle;
---

<article class="group grid gap-x-8 gap-y-2 border-b border-rule py-6 sm:grid-cols-[7rem_1fr]">
  <time datetime={date.toISOString()} class="font-mono text-xs text-ink-faint sm:pt-1.5">
    {isoDate(date)}
  </time>

  <div>
    <h2 class="font-display text-xl font-bold tracking-tight sm:text-2xl">
      <a href={`/posts/${post.id}/`} class="transition-colors hover:text-cobalt">
        {title}
      </a>
    </h2>

    {summary && <p class="mt-2 text-ink-muted">{summary}</p>}

    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-ink-faint">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}/`} class="transition-colors hover:text-cobalt">
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
