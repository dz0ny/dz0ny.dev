---
import { NAV, SITE_NAME } from "@/lib/site";

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? path === "/" : path.startsWith(href);
---

<header class="border-b border-rule">
  <div class="container flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 py-4">
    <a
      href="/"
      class="font-display text-base font-bold tracking-tight text-ink transition-colors hover:text-cobalt"
    >
      {SITE_NAME}
    </a>

    <nav aria-label="Main">
      <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-2 font-mono text-xs">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "uppercase tracking-[0.08em] transition-colors hover:text-cobalt",
                  isActive(item.href) ? "text-cobalt" : "text-ink-muted",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <button
            type="button"
            id="theme-toggle"
            class="uppercase tracking-[0.08em] text-ink-muted transition-colors hover:text-cobalt"
            aria-label="Toggle dark mode"
          >
            <span data-theme-label>Theme</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const label = btn.querySelector("[data-theme-label]");
    const paint = () => {
      if (label)
        label.textContent = document.documentElement.classList.contains("dark")
          ? "Light"
          : "Dark";
    };
    paint();
    btn.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch {}
      paint();
    });
  })();
</script>
