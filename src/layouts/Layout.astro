---
import "../index.css";
import { Font } from "astro:assets";
import Schema from "@/components/Schema.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import type { Thing, WithContext } from "schema-dts";
import { SITE_DESCRIPTION, SITE_NAME } from "@/lib/site";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	socialImageUrl?: string;
	/** RSS/Atom feed URL, e.g. "/index.xml". Emits an autodiscovery <link>. */
	feedUrl?: string;
	schema?: WithContext<Thing> | WithContext<Thing>[];
	/** Long-form pages constrain the column; index pages use the full grid. */
	width?: "prose" | "wide";
}

const { url } = Astro;
const {
	title: pageTitle,
	description = SITE_DESCRIPTION,
	noindex = false,
	socialImageUrl,
	feedUrl = "/index.xml",
	schema,
	width = "wide",
} = Astro.props;

const title = pageTitle ? `${pageTitle} | ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={url.href} />
    <Font cssVariable="--font-display-family" preload />
    <Font cssVariable="--font-body-family" preload />
    <Font cssVariable="--font-code-family" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    {socialImageUrl && (
      <meta property="og:image" content={socialImageUrl} />
      <meta property="og:image:alt" content={title} />
    )}
    {feedUrl && (
      <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={feedUrl} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {schema && (Array.isArray(schema)
      ? schema.map((s) => <Schema item={s} />)
      : <Schema item={schema} />
    )}
    <script is:inline>
      // Set the theme before first paint so there is no flash. Mirrors the
      // "auto" default the Hugo theme had: system preference unless the
      // visitor has chosen otherwise.
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
        } catch {}
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col bg-ground text-ink">
    <Header />

    <main class="flex-1">
      <div class:list={["container py-12 sm:py-16", width === "prose" && "max-w-[46rem]"]}>
        <slot />
      </div>
    </main>

    <Footer />

    <script>
      // Scroll Reveal (MOTION 5): CSS does the animating, this only toggles.
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.15 },
      );
      for (const el of document.querySelectorAll("[data-reveal]")) io.observe(el);
    </script>
  </body>
</html>
