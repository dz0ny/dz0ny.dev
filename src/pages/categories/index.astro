---
import Layout from "@/layouts/Layout.astro";
import { getCategories } from "@/lib/posts";

const categories = await getCategories();
---

<Layout title="Categories" description="Every category used on dz0ny.dev.">
  <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Categories</h1>

  <ul class="mt-10 grid max-w-3xl gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-3">
    {
      categories.map(({ category, count }) => (
        <li class="bg-ground">
          <a href={`/categories/${category}/`} class="flex items-baseline justify-between gap-4 p-4 font-mono text-sm transition-colors hover:bg-surface hover:text-cobalt">
            <span>{category}</span>
            <span class="text-ink-faint">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
