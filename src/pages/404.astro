---
import Layout from "@/layouts/Layout.astro";
import type { WebPage, WithContext } from "schema-dts";

const schema: WithContext<WebPage> = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: "Page Not Found",
	description: "The page you're looking for doesn't exist.",
};

// Where a visitor — or an agent that followed a stale link — should look next.
// Keep these as real, resolving routes: a recovery list that 404s too is worse
// than no list at all. Add the site's main sections here as they get built.
const recovery = [
	{ href: "/", label: "Home", note: "Start here" },
	{ href: "/posts/", label: "Posts", note: "Everything written here" },
	{ href: "/tags/", label: "Tags", note: "Posts by subject" },
	{ href: "/meshcore-sar/", label: "MeshCore SAR", note: "Off-grid LoRa coordination for search and rescue" },
	{ href: "/gramps-viewer/", label: "GRAMPS Viewer", note: "Genealogy viewer for Gramps XML" },
	{ href: "/index.xml", label: "RSS", note: "The feed" },
	{ href: "/sitemap-index.xml", label: "Sitemap", note: "Every page on this site" },
	{ href: "/llms.txt", label: "llms.txt", note: "What this site is, in plain text" },
];
---

<Layout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  noindex={true}
  schema={schema}
>
  <section class="flex min-h-[60vh] items-center justify-center">
    <div class="mx-auto max-w-md text-center">
      <h1 class="font-display text-6xl font-bold tracking-tight">404</h1>
      <p class="mt-3 text-ink-muted">
        This URL doesn't exist on this site. It may have moved, or it may never have
        existed.
      </p>

      <h2 class="label-mono mt-10">
        Where to look next
      </h2>
      <ul class="mt-4 space-y-2 text-left text-sm">
        {recovery.map(({ href, label, note }) => (
          <li>
            <a href={href} class="text-cobalt underline decoration-cobalt/30 underline-offset-4 transition-colors hover:decoration-cobalt">{label}</a>
            <span class="text-ink-muted"> — {note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
