---
import Layout from "@/layouts/Layout.astro";
import PostRow from "@/components/PostRow.astro";
import { getPosts, getTags } from "@/lib/posts";

const posts = await getPosts();
const tags = await getTags();
---

<Layout
  title="Posts"
  description="Everything written on dz0ny.dev: debugging notes, network and radio work, and infrastructure that misbehaved."
>
  <div class="grid gap-12 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-8">
      <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Posts</h1>
      <p class="mt-4 max-w-xl text-ink-muted">
        {posts.length} posts, newest first. Mostly debugging notes written down before I forgot them.
      </p>

      <div class="mt-10">
        {posts.map((post) => <PostRow post={post} />)}
      </div>
    </div>

    <aside class="md:col-span-4 md:border-l md:border-rule md:pl-8">
      <p class="label-mono mb-4">Tags</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 font-mono text-xs">
        {
          tags.map(({ tag, count }) => (
            <li>
              <a href={`/tags/${tag}/`} class="text-ink-muted transition-colors hover:text-cobalt">
                {tag}<span class="text-ink-faint"> {count}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="label-mono mt-10 mb-4">Feed</p>
      <a href="/index.xml" class="font-mono text-xs text-cobalt transition-colors hover:text-cobalt-hover">
        RSS &rarr;
      </a>
    </aside>
  </div>
</Layout>
