---
import Layout from "@/layouts/Layout.astro";

const palette = [
  { token: "ground", role: "60 · page ground", light: "#f9fafc", dark: "#0f1319" },
  { token: "surface", role: "raised panels", light: "#f1f3f6", dark: "#181d24" },
  { token: "rule", role: "hairline structure", light: "#dadee3", dark: "#2b313a" },
  { token: "rule-strong", role: "emphasised rule", light: "#c0c4cb", dark: "#414853" },
  { token: "ink", role: "30 · body + headings", light: "#141a22", dark: "#eaedf1" },
  { token: "ink-muted", role: "metadata", light: "#545b66", dark: "#a5abb5" },
  { token: "ink-faint", role: "de-emphasised", light: "#6a717b", dark: "#7e8590" },
  { token: "cobalt", role: "10 · links + CTAs", light: "#0c63d0", dark: "#609efa" },
  { token: "cobalt-hover", role: "hover / active", light: "#004db2", dark: "#7db9ff" },
  { token: "cobalt-soft", role: "accent wash", light: "#e7f1ff", dark: "#17263b" },
];

const contrast = [
  ["ink on ground", "16.75:1", "AA, all sizes"],
  ["ink-muted on ground", "6.56:1", "AA, all sizes"],
  ["ink-faint on ground", "4.72:1", "AA, all sizes"],
  ["cobalt on ground", "5.42:1", "AA, all sizes"],
  ["white on cobalt fill", "5.66:1", "AA, all sizes"],
];
---

<Layout title="Branding" noindex={true}>
  <div class="space-y-20">
    <!-- Signature move: Asymmetric Split 8/4, Orchestrated Entrance -->
    <section class="rule-top pt-10">
      <p class="label-mono mb-6">Sample hero · asymmetric split 8/4</p>
      <div class="grid gap-10 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-8 entrance">
          <h1 class="font-display text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
            Janez Troha
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">
            Principal engineer at Niteo. I write about networks, radios, and the
            things that fall over at 3am — then I take them apart to find out why.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="#type"
              class="inline-flex items-center gap-2 rounded-sm bg-cobalt px-5 py-2.5 text-sm font-semibold text-white transition-all duration-150 hover:-translate-y-0.5 hover:bg-cobalt-hover active:scale-[0.98]"
            >
              Read the blog <span aria-hidden="true">&rarr;</span>
            </a>
            <a
              href="#components"
              class="inline-flex items-center gap-2 rounded-sm border border-rule-strong px-5 py-2.5 text-sm font-semibold text-ink transition-colors duration-150 hover:border-cobalt hover:text-cobalt"
            >
              Projects
            </a>
          </div>
        </div>
        <div class="md:col-span-4 md:border-l md:border-rule md:pl-8 entrance [animation-delay:120ms]">
          <p class="label-mono mb-4">Posts/</p>
          <ul class="space-y-3 font-mono text-sm">
            <li class="flex gap-4"><span class="text-ink-faint">2024-10</span><a class="text-ink hover:text-cobalt" href="#type">cloudflare-waf</a></li>
            <li class="flex gap-4"><span class="text-ink-faint">2024-08</span><a class="text-ink hover:text-cobalt" href="#type">rpi-onvif-player</a></li>
            <li class="flex gap-4"><span class="text-ink-faint">2019-04</span><a class="text-ink hover:text-cobalt" href="#type">aws-gotchas</a></li>
            <li class="flex gap-4"><span class="text-ink-faint">2017-03</span><a class="text-ink hover:text-cobalt" href="#type">mysql-and-strace</a></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Palette -->
    <section class="rule-top pt-10">
      <p class="label-mono mb-6">Palette · 60 ground / 30 ink / 10 cobalt</p>
      <div class="grid gap-px overflow-hidden rounded-sm border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-5">
        {palette.map((c) => (
          <div class="bg-ground p-4">
            <div class="mb-3 flex h-14 overflow-hidden rounded-sm border border-rule">
              <div class="flex-1" style={`background:${c.light}`}></div>
              <div class="flex-1" style={`background:${c.dark}`}></div>
            </div>
            <p class="font-mono text-xs font-semibold text-ink">{c.token}</p>
            <p class="mt-1 text-xs text-ink-muted">{c.role}</p>
            <p class="mt-2 font-mono text-[11px] text-ink-faint">{c.light} / {c.dark}</p>
          </div>
        ))}
      </div>
      <table class="mt-8 w-full max-w-2xl border-collapse text-sm">
        <tbody>
          {contrast.map(([pair, ratio, verdict]) => (
            <tr class="border-b border-rule">
              <td class="py-2 pr-4 text-ink">{pair}</td>
              <td class="py-2 pr-4 font-mono text-ink-muted">{ratio}</td>
              <td class="py-2 font-mono text-xs text-ink-faint">{verdict}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- Type -->
    <section id="type" class="rule-top pt-10">
      <p class="label-mono mb-6">Type · Space Grotesk / Public Sans / JetBrains Mono</p>
      <div class="space-y-6">
        <div>
          <p class="label-mono mb-2">H1 · display 700</p>
          <p class="font-display text-5xl font-bold tracking-tight sm:text-6xl">Using strace to find what crashes MySQL</p>
        </div>
        <div>
          <p class="label-mono mb-2">H2 · display 700</p>
          <p class="font-display text-3xl font-bold tracking-tight">Off-grid LoRa coordination</p>
        </div>
        <div>
          <p class="label-mono mb-2">H3 · display 500</p>
          <p class="font-display text-xl font-medium">Hardware requirements</p>
        </div>
        <div>
          <p class="label-mono mb-2">Body · Public Sans 400 / 17px / 1.7</p>
          <p class="max-w-2xl text-[17px] leading-[1.7] text-ink">
            MeshCore SAR is a communication layer for search and rescue teams working
            beyond cellular coverage. Paired with MeshCore radios, it gives a team
            messaging, GPS positioning, and offline tactical mapping when the usual
            infrastructure is gone. Šumeča čebela — latin-ext renders correctly.
          </p>
        </div>
        <div>
          <p class="label-mono mb-2">Mono · metadata and code</p>
          <pre class="overflow-x-auto rounded-sm border border-rule bg-surface p-4 font-mono text-sm text-ink"><code>strace -p $(pgrep mysqld) -f -e trace=file 2&gt;&amp;1 | tail -40</code></pre>
        </div>
      </div>
    </section>

    <!-- Components -->
    <section id="components" class="rule-top pt-10">
      <p class="label-mono mb-6">Components · one radius system, borders not fills</p>
      <div class="flex flex-wrap items-center gap-3">
        <button class="rounded-sm bg-cobalt px-5 py-2.5 text-sm font-semibold text-white transition-all duration-150 hover:-translate-y-0.5 hover:bg-cobalt-hover active:scale-[0.98]">Primary action</button>
        <button class="rounded-sm border border-rule-strong px-5 py-2.5 text-sm font-semibold text-ink transition-colors duration-150 hover:border-cobalt hover:text-cobalt">Secondary</button>
        <a href="#type" class="text-sm font-medium text-cobalt underline decoration-cobalt/30 underline-offset-4 transition-colors hover:decoration-cobalt">Inline link</a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <article class="rounded-sm border border-rule p-5">
          <p class="label-mono mb-3">2024-10-10</p>
          <h3 class="font-display text-xl font-bold tracking-tight">Protect your site with Cloudflare's WAF</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">Rules that actually stop the scanners hammering a WordPress install.</p>
          <div class="mt-4 flex gap-2 font-mono text-xs text-ink-faint">
            <span>waf</span><span>cloudflare</span><span>wordpress</span>
          </div>
        </article>
        <div class="rounded-sm border border-rule p-5">
          <label class="label-mono mb-2 block" for="demo">Input</label>
          <input id="demo" type="text" placeholder="hey@dz0ny.dev" class="w-full rounded-sm border border-rule-strong bg-ground px-3 py-2 text-sm text-ink placeholder:text-ink-faint focus:border-cobalt focus:outline-none" />
          <p class="mt-3 rounded-sm bg-cobalt-soft px-3 py-2 font-mono text-xs text-ink">accent wash — used for callouts, never for whole sections</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
